# ============================================================================
# LLM Red-Team & Prompt-Injection Evaluation Harness — Environment Template
# Copy to `.env` for local overrides. Never commit real credentials.
# Zero API keys are required when running in default `mock` mode.
# ============================================================================

# --- Gateway & API Server Hardening ---
# Optional bearer token enforcing authentication on all `/api/v1/*` routes.
# Leave unset for unauthenticated local development.
REDTEAM_API_TOKEN=

# Comma-separated target host allowlist (e.g. api.openai.com,openrouter.ai).
# Empty allows any public HTTPS/HTTP host passing SSRF checks.
REDTEAM_ALLOWED_TARGET_HOSTS=

# Allow private/loopback target URLs (e.g. local Ollama/vLLM at 127.0.0.1:11434)
# on API requests. Cloud metadata ranges (169.254.0.0/16) are always blocked.
REDTEAM_ALLOW_PRIVATE_TARGETS=false

# Optional directory to persist evaluation reports as JSON files.
REDTEAM_ARTIFACTS_DIR=

# Maximum in-memory evaluation runs retained by the API server.
REDTEAM_MAX_STORED_RUNS=200

# Maximum concurrent probes allowed per API evaluation request.
REDTEAM_MAX_CONCURRENCY=20

# --- OpenAI-Compatible Target Endpoint (Optional) ---
REDTEAM_TARGET_BASE_URL=https://api.openai.com/v1
REDTEAM_TARGET_MODEL=gpt-4o-mini
REDTEAM_TARGET_API_KEY=

# --- OpenAI-Compatible LLM-as-a-Judge Endpoint (Optional) ---
REDTEAM_JUDGE_BASE_URL=https://api.openai.com/v1
REDTEAM_JUDGE_MODEL=gpt-4o-mini
REDTEAM_JUDGE_API_KEY=

# Fallback key used when target/judge-specific API keys are omitted.
OPENAI_API_KEY=
